# =============================================================================
# Sekolah Aparatur — local env (Docker Postgres + host Next.js)
# Supabase: comment the local DATABASE_URL and uncomment the pooler pair.
# =============================================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
DEFAULT_LOCALE=id

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sekolah_aparatur
DB_PORT=5434
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5434/sekolah_aparatur
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

APP_PORT=3000
RUN_DB_SEED=true

IMAGE_TAG=
IMAGE_REGISTRY=ghcr.io/nandaiqbalh/sekolah-aparatur
SITE_URL=http://localhost:3002

# Staff seed — super admin only. Do not set SEED_* on Vercel production.
SEED_SUPER_ADMIN_EMAIL=superadmin@sekolah-aparatur.local
SEED_SUPER_ADMIN_PASSWORD=ChangeMeNow123
SEED_SUPER_ADMIN_NAME=Super Admin
SEED_SUPER_ADMIN_USERNAME=superadmin
